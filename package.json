{
  "name": "@juliascript/effectmq",
  "version": "0.1.0",
  "description": "Effect-based message queue",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "turbo run lint",
    "lint:fix": "pnpm biome check --write --unsafe",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "effect": ">=4.0.0-beta.85"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@changesets/cli": "^2.31.0",
    "@testcontainers/redis": "^12.0.3",
    "@types/node": "^22.0.0",
    "effect": "4.0.0-beta.85",
    "@effect/platform-node": "4.0.0-beta.85",
    "ioredis": "^5.11.1",
    "testcontainers": "^12.0.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
