{
  "name": "@effectmq/core",
  "version": "0.2.0",
  "description": "Effect-based message queue",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./NodeRedisPool": {
      "types": "./dist/NodeRedisPool.d.ts",
      "default": "./dist/NodeRedisPool.js"
    },
    "./RedisPool": {
      "types": "./dist/RedisPool.d.ts",
      "default": "./dist/RedisPool.js"
    },
    "./Scheduler": {
      "types": "./dist/Scheduler.d.ts",
      "default": "./dist/Scheduler.js"
    },
    "./Task": {
      "types": "./dist/Task.d.ts",
      "default": "./dist/Task.js"
    },
    "./TaskEngine": {
      "types": "./dist/TaskEngine.d.ts",
      "default": "./dist/TaskEngine.js"
    },
    "./TaskQueue": {
      "types": "./dist/TaskQueue.d.ts",
      "default": "./dist/TaskQueue.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "turbo run lint",
    "lint:fix": "pnpm biome check --write --unsafe",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "effect": ">=4.0.0-beta.85"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@changesets/cli": "^2.31.0",
    "@effect/platform-node": "4.0.0-beta.85",
    "@testcontainers/redis": "^12.0.3",
    "@types/node": "^22.0.0",
    "effect": "4.0.0-beta.85",
    "ioredis": "^5.11.1",
    "testcontainers": "^12.0.3",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "redis": "^6.1.0"
  }
}
